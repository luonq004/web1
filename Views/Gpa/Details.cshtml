@using Lab2.Services
@model Lab2.Models.ViewModels.BangDiemChiTietViewModel

@{
    ViewData["Title"] = $"Bảng điểm sinh viên - {Model.HoTen}";
}

<div class="container-fluid px-4">
    <!-- Breadcrumb & Header không in khi print -->
    <h1 class="mt-4"><i class="fas fa-file-invoice text-primary me-2"></i>Bảng Điểm & Kết Quả Học Tập</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Tính GPA & Xếp loại</a></li>
        <li class="breadcrumb-item active">@Model.HoTen (@Model.MaSv)</li>
    </ol>

    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Thông tin cá nhân sinh viên & Thống kê tích lũy -->
    <div class="card mb-4 shadow-sm border-primary">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span><i class="fas fa-user-graduate me-1"></i> <strong>HỒ SƠ HỌC TẬP SINH VIÊN</strong></span>
            <span class="badge bg-light text-primary fs-6">@Model.MaSv</span>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-7 border-end-md">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Họ và tên:</dt>
                        <dd class="col-sm-8 fs-5 fw-bold text-dark">@Model.HoTen</dd>

                        <dt class="col-sm-4 text-muted">Ngày sinh:</dt>
                        <dd class="col-sm-8">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4 text-muted">Giới tính:</dt>
                        <dd class="col-sm-8">@Model.GioiTinh</dd>

                        <dt class="col-sm-4 text-muted">Lớp hành chính:</dt>
                        <dd class="col-sm-8 fw-semibold text-primary">@Model.TenLop</dd>

                        <dt class="col-sm-4 text-muted">Khoa / Viện:</dt>
                        <dd class="col-sm-8">@Model.TenKhoa</dd>

                        <dt class="col-sm-4 text-muted">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                    </dl>
                </div>
                <div class="col-md-5 pt-3 pt-md-0">
                    <div class="p-3 bg-light rounded text-center">
                        <h6 class="text-uppercase text-muted fw-bold mb-3">TỔNG KẾT TÍCH LŨY TOÀN KHÓA</h6>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="p-2 border bg-white rounded">
                                    <div class="small text-muted">GPA (Thang 4)</div>
                                    <div class="fs-4 fw-bold text-primary">
                                        @(Model.GpaTichLuyThang4.HasValue ? Model.GpaTichLuyThang4.Value.ToString("0.00") : "N/A")
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border bg-white rounded">
                                    <div class="small text-muted">GPA (Thang 10)</div>
                                    <div class="fs-4 fw-bold text-dark">
                                        @(Model.GpaTichLuyThang10.HasValue ? Model.GpaTichLuyThang10.Value.ToString("0.00") : "N/A")
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border bg-white rounded">
                                    <div class="small text-muted">Tín chỉ tích lũy</div>
                                    <div class="fs-5 fw-bold text-success">
                                        @Model.TongTinChiTichLuy <span class="small text-muted">/ @Model.TongTinChiDangKy</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border bg-white rounded">
                                    <div class="small text-muted">Xếp loại toàn khóa</div>
                                    <div class="mt-1">
                                        <span class="badge @GpaCalculator.LayBadgeClass(Model.XepLoaiTichLuy) fs-6">
                                            @Model.XepLoaiTichLuy
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng điểm chi tiết theo từng Học kỳ -->
    @if (Model.DanhSachHocKy.Any())
    {
        @foreach (var hk in Model.DanhSachHocKy)
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-calendar-check text-success me-2"></i>
                        <strong class="fs-6 text-dark">@hk.TenHocKy</strong>
                    </div>
                    <div>
                        <span class="badge @GpaCalculator.LayBadgeClass(hk.XepLoaiHocKy) me-2">
                            @hk.XepLoaiHocKy
                        </span>
                        <span class="badge bg-secondary">
                            @hk.TongTinChiDat / @hk.TongTinChiDangKy Tín chỉ
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle mb-0">
                            <thead class="table-light text-center small">
                                <tr>
                                    <th style="width: 50px;">STT</th>
                                    <th style="width: 100px;">Mã môn</th>
                                    <th>Tên môn học</th>
                                    <th style="width: 80px;">Số TC</th>
                                    <th>Giảng viên</th>
                                    <th style="width: 90px;">Điểm QT (0.4)</th>
                                    <th style="width: 90px;">Điểm Thi (0.6)</th>
                                    <th style="width: 110px;">Điểm TK (Hệ 10)</th>
                                    <th style="width: 80px;">Điểm chữ</th>
                                    <th style="width: 90px;">Điểm Hệ 4</th>
                                    <th style="width: 100px;">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int stt = 1; }
                                @foreach (var mon in hk.DanhSachMon)
                                {
                                    <tr>
                                        <td class="text-center">@stt</td>
                                        <td class="text-center fw-semibold">@mon.MaMon</td>
                                        <td class="fw-bold">@mon.TenMon</td>
                                        <td class="text-center">@mon.SoTinChi</td>
                                        <td>@mon.GiangVien</td>
                                        <td class="text-center">@(mon.DiemQuaTrinh?.ToString("0.0") ?? "-")</td>
                                        <td class="text-center">@(mon.DiemThi?.ToString("0.0") ?? "-")</td>
                                        <td class="text-center fw-bold text-danger fs-6">
                                            @(mon.DiemTongKet?.ToString("0.0") ?? "-")
                                        </td>
                                        <td class="text-center fw-bold">@mon.DiemChu</td>
                                        <td class="text-center fw-bold text-primary">
                                            @(mon.DiemHe4?.ToString("0.0") ?? "-")
                                        </td>
                                        <td class="text-center">
                                            @if (mon.DiemTongKet.HasValue)
                                            {
                                                if (mon.DaDat)
                                                {
                                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Đạt</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Học lại</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Chưa có điểm</span>
                                            }
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Tổng kết học kỳ:</td>
                                    <td class="text-center">@hk.TongTinChiDangKy (Đạt: @hk.TongTinChiDat)</td>
                                    <td colspan="3" class="text-end">GPA Học kỳ:</td>
                                    <td class="text-center text-danger fs-6">
                                        @(hk.GpaHocKyThang10.HasValue ? hk.GpaHocKyThang10.Value.ToString("0.00") : "-")
                                    </td>
                                    <td class="text-center">-</td>
                                    <td class="text-center text-primary fs-6">
                                        @(hk.GpaHocKyThang4.HasValue ? hk.GpaHocKyThang4.Value.ToString("0.00") : "-")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @GpaCalculator.LayBadgeClass(hk.XepLoaiHocKy)">
                                            @hk.XepLoaiHocKy
                                        </span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                <i class="fas fa-clipboard-list fa-3x mb-3 text-secondary opacity-50"></i>
                <h5>Sinh viên chưa có dữ liệu điểm học kỳ nào</h5>
                <p class="small text-muted mb-0">Chưa có kết quả học tập được ghi nhận cho sinh viên này.</p>
            </div>
        </div>
    }
</div>

