@using Lab2.Services
@model Lab2.Models.PaginatedList<Lab2.Models.ViewModels.SinhVienGpaSummaryViewModel>

@{
    ViewData["Title"] = "Tính GPA & Xếp loại Học tập";
}

<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-graduation-cap text-warning me-2"></i>Tính GPA & Xếp Loại Học Tập</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Bảng Xếp loại & GPA Sinh viên</li>
    </ol>

    <!-- Thống kê nhanh Xếp loại -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm bg-dark text-white text-center py-2">
                <div class="small text-uppercase opacity-75">Tổng SV</div>
                <div class="fs-4 fw-bold">@ViewBag.CountTotal</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm bg-danger text-white text-center py-2">
                <div class="small text-uppercase opacity-75">Xuất sắc</div>
                <div class="fs-4 fw-bold">@ViewBag.CountXuatSac</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm bg-success text-white text-center py-2">
                <div class="small text-uppercase opacity-75">Giỏi</div>
                <div class="fs-4 fw-bold">@ViewBag.CountGioi</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm bg-primary text-white text-center py-2">
                <div class="small text-uppercase opacity-75">Khá</div>
                <div class="fs-4 fw-bold">@ViewBag.CountKha</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm bg-warning text-dark text-center py-2">
                <div class="small text-uppercase opacity-75">Trung bình</div>
                <div class="fs-4 fw-bold">@ViewBag.CountTrungBinh</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm bg-secondary text-white text-center py-2">
                <div class="small text-uppercase opacity-75">Yếu</div>
                <div class="fs-4 fw-bold">@ViewBag.CountYeu</div>
            </div>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-chart-line text-primary me-1"></i>
                <strong>Danh sách Xếp loại & GPA Sinh viên</strong> (@Model.TotalCount kết quả)
            </div>
        </div>
        <div class="card-body">
            <!-- Form Tìm kiếm & Đa bộ lọc -->
            <form asp-action="Index" method="get" class="row g-2 mb-4 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1 fw-bold">Khoa:</label>
                    <select name="khoaId" class="form-select form-select-sm" asp-items="ViewBag.KhoaList" onchange="this.form.submit()">
                        <option value="">-- Tất cả Khoa --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1 fw-bold">Lớp:</label>
                    <select name="lopId" class="form-select form-select-sm" asp-items="ViewBag.LopList" onchange="this.form.submit()">
                        <option value="">-- Tất cả Lớp --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1 fw-bold">Học kỳ:</label>
                    <select name="hocKyId" class="form-select form-select-sm" asp-items="ViewBag.HocKyList" onchange="this.form.submit()">
                        <option value="">-- Toàn khóa (Tích lũy) --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1 fw-bold">Xếp loại:</label>
                    <select name="xepLoai" class="form-select form-select-sm" asp-items="ViewBag.XepLoaiList" onchange="this.form.submit()">
                        <option value="">-- Tất cả Xếp loại --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1 fw-bold">Tìm kiếm:</label>
                    <div class="input-group input-group-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
                               class="form-control" placeholder="Mã SV hoặc Họ tên..." />
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                @if (ViewData["CurrentKhoaId"] != null || ViewData["CurrentLopId"] != null || 
                     ViewData["CurrentHocKyId"] != null || !string.IsNullOrEmpty((string)ViewData["CurrentXepLoai"]!) || 
                     !string.IsNullOrEmpty((string)ViewData["CurrentFilter"]!))
                {
                    <div class="col-12 mt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-undo me-1"></i> Xóa tất cả bộ lọc
                        </a>
                    </div>
                }
            </form>

            <!-- Bảng dữ liệu GPA -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th style="width: 50px;">STT</th>
                            <th>Mã SV</th>
                            <th>Họ và tên</th>
                            <th>Lớp</th>
                            <th>Khoa</th>
                            <th>TC Đạt / ĐK</th>
                            <th>GPA (Thang 10)</th>
                            <th>GPA (Thang 4)</th>
                            <th>Xếp loại học lực</th>
                            <th style="width: 140px;">Bảng điểm</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int index = (Model.PageIndex - 1) * Model.PageSize + 1;
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@index</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@item.MaSv</span>
                                    </td>
                                    <td class="fw-semibold">@item.HoTen</td>
                                    <td>@item.TenLop</td>
                                    <td><span class="badge bg-light text-dark border">@item.TenKhoa</span></td>
                                    <td class="text-center">
                                        <span class="fw-bold text-success">@item.TongTinChiTichLuy</span> / 
                                        <span class="text-muted">@item.TongTinChiDangKy</span>
                                    </td>
                                    <td class="text-center fw-bold fs-6">
                                        @(item.GpaThang10.HasValue ? item.GpaThang10.Value.ToString("0.00") : "-")
                                    </td>
                                    <td class="text-center fw-bold fs-6 text-primary">
                                        @(item.GpaThang4.HasValue ? item.GpaThang4.Value.ToString("0.00") : "-")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @GpaCalculator.LayBadgeClass(item.XepLoai) px-2 py-1">
                                            @item.XepLoai
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.SinhVienId" class="btn btn-sm btn-outline-primary" title="Xem bảng điểm chi tiết">
                                            <i class="fas fa-file-invoice me-1"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle me-1"></i> Không tìm thấy sinh viên nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageNumber="@(Model.PageIndex - 1)"
                               asp-route-khoaId="@ViewData["CurrentKhoaId"]"
                               asp-route-lopId="@ViewData["CurrentLopId"]"
                               asp-route-hocKyId="@ViewData["CurrentHocKyId"]"
                               asp-route-xepLoai="@ViewData["CurrentXepLoai"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]">
                                <i class="fas fa-chevron-left"></i> Trước
                            </a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-pageNumber="@p"
                                   asp-route-khoaId="@ViewData["CurrentKhoaId"]"
                                   asp-route-lopId="@ViewData["CurrentLopId"]"
                                   asp-route-hocKyId="@ViewData["CurrentHocKyId"]"
                                   asp-route-xepLoai="@ViewData["CurrentXepLoai"]"
                                   asp-route-searchString="@ViewData["CurrentFilter"]">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageNumber="@(Model.PageIndex + 1)"
                               asp-route-khoaId="@ViewData["CurrentKhoaId"]"
                               asp-route-lopId="@ViewData["CurrentLopId"]"
                               asp-route-hocKyId="@ViewData["CurrentHocKyId"]"
                               asp-route-xepLoai="@ViewData["CurrentXepLoai"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]">
                                Sau <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

