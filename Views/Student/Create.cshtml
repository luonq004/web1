@model Student

@{
    ViewData["Title"] = "Thêm mới sinh viên";
}

<div class="container mt-3">
    <h3>Thêm mới sinh viên</h3>
    <div>
        <form asp-controller="Student" asp-action="Create" method="post" class="mt-3" enctype="multipart/form-data">

            <!-- Họ tên -->
            <div class="row mb-3">
                <label asp-for="Name" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="Name" class="form-control" placeholder="Họ tên" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <!-- Email -->
            <div class="row mb-3">
                <label asp-for="Email" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="Email" type="email" class="form-control" placeholder="example@gmail.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <!-- Mật khẩu -->
            <div class="row mb-3">
                <label asp-for="Password" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <!-- Điểm (Trường mới theo yêu cầu) -->
            <div class="row mb-3">
                <label asp-for="Score" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="Score" type="number" step="0.1" class="form-control" placeholder="Nhập điểm từ 0.0 - 10.0" />
                    <span asp-validation-for="Score" class="text-danger"></span>
                </div>
            </div>

            <!-- Ngành học -->
            <div class="row mb-3">
                <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <select asp-for="Branch" class="form-select" asp-items="ViewBag.AllBranches">
                        <option value="">-- Chọn ngành học --</option>
                    </select>
                    <span asp-validation-for="Branch" class="text-danger"></span>
                </div>
            </div>

            <!-- Giới tính -->
            <div class="row mb-3">
                <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    @if (ViewBag.AllGenders != null)
                    {
                        @foreach (var gender in ViewBag.AllGenders)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" id="Gender_@gender" />
                                <label class="form-check-label" for="Gender_@gender">@gender</label>
                            </div>
                        }
                    }
                    <div>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Hệ đào tạo -->
            <div class="row mb-3">
                <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10 d-flex align-items-center">
                    <input type="checkbox" class="form-check-input mt-0" asp-for="IsRegular" />
                    <span asp-validation-for="IsRegular" class="text-danger ms-2"></span>
                </div>
            </div>

            <!-- Ngày sinh -->
            <div class="row mb-3">
                <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="DateOfBorth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBorth" class="text-danger"></span>
                </div>
            </div>

            <!-- Địa chỉ -->
            <div class="row mb-3">
                <label asp-for="Address" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <!-- Upload ảnh đại diện -->
            <div class="row mb-3">
                <label asp-for="Avatar" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input type="file" name="avatarFile" class="form-control" accept="image/*" />
                </div>
            </div>

            <!-- Nút bấm -->
            <div class="row mt-4">
                <div class="col-sm-10 offset-sm-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy / Quay lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}