@model SinhVien

@{
    ViewData["Title"] = "Chi tiết Sinh viên";
}

<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-id-card text-info me-2"></i>Chi Tiết Sinh Viên</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Sinh viên</a></li>
        <li class="breadcrumb-item active">@Model.HoTen</li>
    </ol>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-user-circle me-1"></i> Hồ sơ sinh viên
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Mã sinh viên:</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary fs-6">@Model.MaSv</span></dd>

                        <dt class="col-sm-4 text-muted">Họ và tên:</dt>
                        <dd class="col-sm-8 fs-5 fw-bold text-dark">@Model.HoTen</dd>

                        <dt class="col-sm-4 text-muted">Ngày sinh:</dt>
                        <dd class="col-sm-8">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4 text-muted">Giới tính:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.GioiTinh == "Nam" ? "bg-info text-dark" : "bg-danger")">
                                @Model.GioiTinh
                            </span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Email:</dt>
                        <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                        <dt class="col-sm-4 text-muted">Lớp học:</dt>
                        <dd class="col-sm-8 fw-semibold">
                            @(Model.Lop?.TenLop ?? "Chưa rõ")
                        </dd>

                        <dt class="col-sm-4 text-muted">Khoa:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">@(Model.Lop?.Khoa?.TenKhoa ?? "Chưa rõ")</span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm text-dark">
                        <i class="fas fa-edit me-1"></i> Chỉnh sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
