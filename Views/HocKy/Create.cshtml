@model Lab2.Models.Entities.HocKy
@{
    ViewData["Title"] = "Thêm mới Học kỳ";
}
<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-plus-circle text-secondary me-2"></i>Thêm Học Kỳ Mới</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Học kỳ</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>
    <div class="row">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-calendar-alt me-1"></i> Thông tin Học kỳ
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="NamHoc" class="form-label fw-bold"></label>
                            <input asp-for="NamHoc" class="form-control" placeholder="VD: 2023-2024" />
                            <span asp-validation-for="NamHoc" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Ky" class="form-label fw-bold"></label>
                            <select asp-for="Ky" class="form-select">
                                <option value="1">Kỳ 1</option>
                                <option value="2">Kỳ 2</option>
                                <option value="3">Kỳ 3 (Hè)</option>
                            </select>
                            <span asp-validation-for="Ky" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-secondary text-white fw-bold">
                                <i class="fas fa-save me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
