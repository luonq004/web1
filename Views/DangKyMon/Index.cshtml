@model PaginatedList<Lab2.Models.Entities.DangKyMon>

@{
    ViewData["Title"] = "Quản lý Đăng ký môn";
}

<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-clipboard-list text-success me-2"></i>Quản lý Đăng ký môn</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Danh sách Đăng ký môn</li>
    </ol>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-table me-1"></i>
                <strong>Danh sách Đăng ký môn</strong> (@Model.TotalCount bản ghi)
            </div>
            <a asp-action="Create" class="btn btn-warning btn-sm text-dark fw-semibold">
                <i class="fas fa-plus-circle me-1"></i> Đăng ký mới
            </a>
        </div>
        <div class="card-body">
            <!-- Form Tìm kiếm -->
            <form asp-action="Index" method="get" class="row g-2 mb-3 align-items-center">
                <div class="col-md-5 col-lg-4">
                    <label class="form-label small text-muted mb-1 fw-bold">Tìm kiếm:</label>
                    <div class="input-group input-group-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
                               class="form-control" placeholder="Tìm theo Mã SV hoặc Tên SV..." />
                        <button type="submit" class="btn btn-outline-success text-dark">
                            <i class="fas fa-search"></i> Tìm
                        </button>
                    </div>
                </div>
                <div class="col-auto align-self-end">
                    @if (!string.IsNullOrEmpty((string)ViewData["CurrentFilter"]!))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-undo me-1"></i> Xóa lọc
                        </a>
                    }
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;" class="text-center">STT</th>
                            <th>Sinh viên</th>
                            <th>Lớp học phần (Môn)</th>
                            <th style="width: 220px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int index = (Model.PageIndex - 1) * Model.PageSize + 1;
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@index</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.SinhVien.MaSv</span><br/>
                                        <span class="fw-semibold">@item.SinhVien.HoTen</span>
                                    </td>
                                    <td>
                                        @if (item.LopHocPhan.MonHoc != null)
                                        {
                                            <span>@item.LopHocPhan.MonHoc.TenMon</span><br/>
                                            <span class="text-muted small">GV: @item.LopHocPhan.GiangVien</span>
                                        }
                                        else
                                        {
                                            <span>LHP ID: @item.LopHocPhanId</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle me-1"></i> Không tìm thấy bản ghi nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageNumber="@(Model.PageIndex - 1)"
                               asp-route-searchString="@ViewData["CurrentFilter"]">
                                <i class="fas fa-chevron-left"></i> Trước
                            </a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-pageNumber="@p"
                                   asp-route-searchString="@ViewData["CurrentFilter"]">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageNumber="@(Model.PageIndex + 1)"
                               asp-route-searchString="@ViewData["CurrentFilter"]">
                                Sau <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
