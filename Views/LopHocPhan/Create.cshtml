@model Lab2.Models.Entities.LopHocPhan
@{
    ViewData["Title"] = "Thêm mới Lớp học phần";
}
<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-plus-circle text-primary me-2"></i>Thêm Lớp Học Phần Mới</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Lớp học phần</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-layer-group me-1"></i> Thông tin Lớp học phần
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="MonHocId" class="form-label fw-bold">Môn học</label>
                            <select asp-for="MonHocId" class="form-select" asp-items="ViewBag.MonHocId"></select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="HocKyId" class="form-label fw-bold">Học kỳ</label>
                            <select asp-for="HocKyId" class="form-select" asp-items="ViewBag.HocKyId"></select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="GiangVien" class="form-label fw-bold">Giảng viên</label>
                            <input asp-for="GiangVien" class="form-control" placeholder="Tên giảng viên giảng dạy" />
                            <span asp-validation-for="GiangVien" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary fw-bold">
                                <i class="fas fa-save me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
