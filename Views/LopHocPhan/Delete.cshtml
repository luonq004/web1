@model Lab2.Models.Entities.LopHocPhan
@{
    ViewData["Title"] = "Xóa Lớp học phần";
}
<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-trash text-danger me-2"></i>Xóa Lớp Học Phần</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Lớp học phần</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>
    <div class="alert alert-danger shadow-sm">
        <i class="fas fa-exclamation-triangle me-1"></i> Bạn có chắc chắn muốn xóa lớp học phần này không?
    </div>
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <i class="fas fa-layer-group me-1"></i> Chi tiết Lớp học phần
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Môn học</dt>
                        <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.MonHoc.TenMon)</dd>
                        <dt class="col-sm-4 text-muted">Học kỳ</dt>
                        <dd class="col-sm-8 fw-bold">Kỳ @Html.DisplayFor(model => model.HocKy.Ky) - Năm @Html.DisplayFor(model => model.HocKy.NamHoc)</dd>
                        <dt class="col-sm-4 text-muted">Giảng viên</dt>
                        <dd class="col-sm-8 fw-bold text-primary">@Html.DisplayFor(model => model.GiangVien)</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger fw-bold">
                            <i class="fas fa-trash me-1"></i> Xác nhận xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
