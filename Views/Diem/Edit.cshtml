@model Lab2.Models.Entities.Diem
@{
    ViewData["Title"] = "Cập nhật điểm";
}
<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-edit text-warning me-2"></i>Cập nhật Điểm</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Điểm</a></li>
        <li class="breadcrumb-item active">Cập nhật</li>
    </ol>
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <i class="fas fa-star me-1"></i> Thông tin Điểm
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="DangKyId" class="form-label fw-bold">Đăng ký môn</label>
                            <select asp-for="DangKyId" class="form-select" asp-items="ViewBag.DangKyId"></select>
                            <span asp-validation-for="DangKyId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DiemQuaTrinh" class="form-label fw-bold">Điểm Quá trình</label>
                            <input asp-for="DiemQuaTrinh" type="number" step="0.1" min="0" max="10" class="form-control" />
                            <span asp-validation-for="DiemQuaTrinh" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DiemThi" class="form-label fw-bold">Điểm Thi</label>
                            <input asp-for="DiemThi" type="number" step="0.1" min="0" max="10" class="form-control" />
                            <span asp-validation-for="DiemThi" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DiemTongKet" class="form-label fw-bold">Điểm Tổng kết</label>
                            <input asp-for="DiemTongKet" type="number" step="0.1" min="0" max="10" class="form-control bg-light" readonly />
                            <span asp-validation-for="DiemTongKet" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning text-dark fw-bold">
                                <i class="fas fa-save me-1"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const txtQuaTrinh = document.getElementById('DiemQuaTrinh');
            const txtThi = document.getElementById('DiemThi');
            const txtTongKet = document.getElementById('DiemTongKet');

            function calculateTongKet() {
                const p = parseFloat(txtQuaTrinh.value);
                const t = parseFloat(txtThi.value);
                if (!isNaN(p) && !isNaN(t)) {
                    let tong = p * 0.4 + t * 0.6;
                    txtTongKet.value = Math.round(tong * 10) / 10;
                } else {
                    txtTongKet.value = '';
                }
            }

            txtQuaTrinh.addEventListener('input', calculateTongKet);
            txtThi.addEventListener('input', calculateTongKet);
        });
    </script>
}
