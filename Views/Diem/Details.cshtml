@model Lab2.Models.Entities.Diem
@{
    ViewData["Title"] = "Chi tiết điểm";
}
<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-info-circle text-info me-2"></i>Chi tiết Điểm</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Điểm</a></li>
        <li class="breadcrumb-item active">Chi tiết</li>
    </ol>
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-star me-1"></i> Kết quả Điểm
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Sinh viên</dt>
                        <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.DangKyMon.SinhVien.HoTen)</dd>
                        
                        <dt class="col-sm-4 text-muted">Môn học</dt>
                        <dd class="col-sm-8 fw-bold text-primary">@Html.DisplayFor(model => model.DangKyMon.LopHocPhan.MonHoc.TenMon)</dd>
                        
                        <dt class="col-sm-4 text-muted mt-3">Điểm Quá trình</dt>
                        <dd class="col-sm-8 fw-bold mt-3">@Html.DisplayFor(model => model.DiemQuaTrinh)</dd>
                        
                        <dt class="col-sm-4 text-muted">Điểm Thi</dt>
                        <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.DiemThi)</dd>
                        
                        <dt class="col-sm-4 text-muted">Điểm Tổng kết</dt>
                        <dd class="col-sm-8 fw-bold text-danger fs-5">@Html.DisplayFor(model => model.DiemTongKet)</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark fw-bold">
                        <i class="fas fa-edit me-1"></i> Cập nhật
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
